{
	"name": "@greenpt/n8n-nodes-greenpt",
	"version": "0.1.0",
	"description": "GreenPT chat, embedding, reranking and speech-to-text models for n8n",
	"license": "MIT",
	"homepage": "https://docs.greenpt.ai/automation/n8n",
	"keywords": [
		"n8n-community-node-package",
		"greenpt",
		"llm",
		"ai",
		"chat-model"
	],
	"author": {
		"name": "GreenPT",
		"email": "mail@greenpt.ai",
		"url": "https://greenpt.ai"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Green-PT/n8n-nodes-greenpt.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"aiNodeSdkVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/GreenPtApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/LmChatGreenPt/LmChatGreenPt.node.js",
			"dist/nodes/EmbeddingsGreenPt/EmbeddingsGreenPt.node.js",
			"dist/nodes/RerankerGreenPt/RerankerGreenPt.node.js",
			"dist/nodes/GreenPt/GreenPt.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*",
		"@n8n/ai-node-sdk": "*"
	},
	"publishConfig": {
		"access": "public"
	}
}
